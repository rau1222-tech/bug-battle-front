# Supabase (public client values; never put service-role keys here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# â”€â”€ Local AI (all optional: the defaults work without a .env) â”€â”€
# Browser side (public values only, no secrets)
VITE_LOCAL_AI_SERVICE_URL=http://127.0.0.1:8787
VITE_LOCAL_AI_TIMEOUT_MS=35000

# Local AI service (local-ai/)
LOCAL_AI_PORT=8787
LOCAL_AI_ALLOWED_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# Set to false to stop `npm run dev` from starting the service
LOCAL_AI_AUTOSTART=true
# The service runs its own Ollama on this port with models stored in local-ai/models
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.3
OLLAMA_TIMEOUT_MS=30000
# false = use an Ollama you start yourself at OLLAMA_BASE_URL (models in its own folder)
LOCAL_AI_MANAGE_OLLAMA=true
# Per-generation timing logs (no prompts or player data); npm run dev enables it
LOCAL_AI_DEBUG=false
# The Ollama runtime version is pinned in local-ai/release.ts (not configurable). Nothing is downloaded
# until the player clicks "Prepare local AI" or you run npm run ai:setup.
